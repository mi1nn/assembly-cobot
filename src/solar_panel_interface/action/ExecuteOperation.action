# ROS Bridge -> Controller 노드
# IF-14 Work Order / Execution / Operation 정보 + 작업 Parameter / Components

# Goal
uint64 work_order_id
uint64 work_execution_id
uint64 operation_id

# DB operation.code
# 예: postA, postB, postC ...
string operation_code

uint64 operation_execution_id
uint64 robot_id

solar_panel_interface/Parameter[] parameters

# operation.components(JSONB)를 JSON 문자열로 전달
string components
---
# IF-16: Controller -> ROS Bridge
# Result

bool success
string error_code
string message
---
# IF-15: Controller -> ROS Bridge
# Feedback

uint8 STATUS_PENDING=0
uint8 STATUS_RUNNING=1
uint8 STATUS_COMPLETED=2
uint8 STATUS_FAILED=3
uint8 STATUS_CANCELLED=4

uint64 operation_execution_id
uint8 status
string message
